          >
            <Download className="w-3.5 h-3.5 text-brand-secondary" /> JSON DATA
          </button>
        </div>

        {/* Section F: Developer Signature Footer Card */}
        <div className="mt-auto p-4 rounded-lg bg-brand-bg/80 border border-brand-border text-xs font-mono">
